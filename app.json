{
  "expo": {
    "name": "VanEscolar GPS",
    "slug": "bus-tracker-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "vanescolar",
    "experiments": {
      "typedRoutes": true
    }
  }
}
