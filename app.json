{
  "expo": {
    "name": "VanEscolar GPS",
    "slug": "bus-tracker-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      ["expo-location", { "locationWhenInUsePermission": "O VanEscolar usa sua localização durante a rota para os responsáveis acompanharem a van." }]
    ],
    "scheme": "vanescolar",
    "experiments": {
      "typedRoutes": true
    }
  }
}
