classDiagram
    direction TB

    class Usuario {
        <<abstract>>
        -UUID id
        -String nome
        -String email
        -String cpf
        -String telefone
        -TipoUsuario tipoUsuario
        -Boolean ativo
        -DateTime criadoEm
        -DateTime atualizadoEm
        +autenticar(senha) Boolean
        +atualizarPerfil(dados) void
        +alterarSenha(senhaAtual, novaSenha) Boolean
        +desativarConta() void
    }

    class Responsavel {
        -String enderecoResidencial
        +cadastrarAluno(dadosAluno) Aluno
        +comunicarAusencia(alunoId, periodo, motivo) ComunicadoAusencia
        +pagarMensalidade(mensalidadeId, metodo) Pagamento
        +acompanharTransporte() ViagemTransporte
    }

    class Transportador {
        -String cnh
        -String categoriaCnh
        -String numeroCredencial
        -String alvaraAutonomo
        -String fotoUrl
        -String codigoConvite
        -Decimal valorMensalidadePadrao
        -Integer diaVencimentoPadrao
        -String chavePix
        +cadastrarVeiculo(dadosVeiculo) Veiculo
        +iniciarViagem(tipo, turno) ViagemTransporte
        +finalizarViagem(viagemId) void
        +registrarEmbarque(alunoId, viagemId) RegistroEmbarqueDesembarque
        +registrarEventoRota(viagemId, tipo, desc) EventoRota
        +emitirContrato(responsavelId, alunoId, valor) ContratoServico
    }

    class EnderecoResponsavel {
        -UUID id
        -String rotulo
        -String enderecoTexto
        -Double latitude
        -Double longitude
        -String precisao
        -String origem
        -Boolean ajustadoManual
        -DateTime geocodificadoEm
        -DateTime criadoEm
    }

    class TipoUsuario {
        <<enumeration>>
        RESPONSAVEL
        TRANSPORTADOR
    }

    class Aluno {
        -UUID id
        -String nome
        -Date dataNascimento
        -String documento
        -String turma
        -Turno turno
        -String enderecoBusca
        -String enderecoEntrega
        -String escolaNome
        -String escolaEndereco
        -String observacoesMedicas
        -String fotoUrl
        -Boolean ativo
        -DateTime criadoEm
    }

    class PessoaAutorizada {
        -UUID id
        -String nome
        -String cpf
        -String telefone
        -String grauParentesco
        -String fotoUrl
        -Boolean ativo
        -DateTime criadoEm
    }

    class ComunicadoAusencia {
        -UUID id
        -Date dataInicio
        -Date dataFim
        -PeriodoAusencia periodo
        -String motivo
        -DateTime notificadoEm
    }

    class PeriodoAusencia {
        <<enumeration>>
        IDA
        VOLTA
        AMBOS
    }

    class Turno {
        <<enumeration>>
        MANHA
        TARDE
        INTEGRAL
        NOITE
    }

    class Veiculo {
        -UUID id
        -String placa
        -String modelo
        -Integer ano
        -Integer capacidadeAssentos
        -String renavam
        -String numeroAlvara
        -Date validadeVistoria
        -Boolean ativo
        -DateTime criadoEm
    }

    class ViagemTransporte {
        -UUID id
        -TipoViagem tipoViagem
        -Turno turno
        -DateTime dataHoraInicio
        -DateTime dataHoraFim
        -StatusViagem status
        -Decimal kmPercorrido
        -DateTime criadoEm
    }

    class LocalizacaoGPS {
        -UUID id
        -Point posicao
        -Decimal velocidade
        -Decimal direcao
        -Decimal precisaoMetros
        -DateTime timestamp
    }

    class RegistroEmbarqueDesembarque {
        -UUID id
        -TipoRegistro tipo
        -DateTime dataHora
        -Decimal latitude
        -Decimal longitude
        -Boolean registradoOffline
        -DateTime sincronizadoEm
    }

    class EventoRota {
        -UUID id
        -String tipo
        -String descricao
        -String severidade
        -Decimal latitude
        -Decimal longitude
        -DateTime dataHora
    }

    class CalendarioEscolar {
        -UUID id
        -Date data
        -String titulo
        -TipoDiaCalendario tipo
        -String descricao
    }

    class StatusViagem {
        <<enumeration>>
        AGENDADA
        EM_ANDAMENTO
        CONCLUIDA
        CANCELADA
    }

    class TipoViagem {
        <<enumeration>>
        IDA
        VOLTA
    }

    class TipoRegistro {
        <<enumeration>>
        EMBARQUE
        DESEMBARQUE
    }

    class TipoDiaCalendario {
        <<enumeration>>
        LETIVO
        FERIADO
        RECESSO
        EVENTO
    }

    class ContratoServico {
        -UUID id
        -String numeroContrato
        -Date dataInicio
        -Date dataTermino
        -Decimal valorMensalidade
        -Integer diaVencimento
        -StatusContrato status
        -String termosCondicoes
        -DateTime criadoEm
    }

    class Mensalidade {
        -UUID id
        -Integer mesReferencia
        -Integer anoReferencia
        -Decimal valor
        -Date dataVencimento
        -Decimal valorMultaJuros
        -StatusMensalidade status
        -DateTime criadoEm
    }

    class Pagamento {
        -UUID id
        -MetodoPagamento metodo
        -Decimal valorPago
        -DateTime dataPagamento
        -String transacaoId
        -JSON detalhesMetodo
        -String status
    }

    class StatusContrato {
        <<enumeration>>
        ATIVO
        SUSPENSO
        CANCELADO
        ENCERRADO
    }

    class StatusMensalidade {
        <<enumeration>>
        PENDENTE
        PAGO
        VENCIDO
        CANCELADO
    }

    class MetodoPagamento {
        <<enumeration>>
        PIX
        CARTAO
        BOLETO
    }

    class Mensagem {
        -UUID id
        -UUID remetenteId
        -String remetenteNome
        -OrigemMensagem origem
        -String texto
        -DateTime criadoEm
    }

    class OrigemMensagem {
        <<enumeration>>
        PAIS
        MOTORISTA
    }

    class Notificacao {
        -UUID id
        -String tipo
        -String titulo
        -String mensagem
        -Boolean lida
        -DateTime criadoEm
    }

    class PushToken {
        -String token
        -String plataforma
        -DateTime atualizadoEm
    }

    Usuario <|-- Responsavel : herda
    Usuario <|-- Transportador : herda
    Usuario ..> TipoUsuario : classifica

    Responsavel "1" *-- "0..*" Aluno : eh_responsavel_por
    Responsavel "1" *-- "0..*" EnderecoResponsavel : possui_enderecos
    Aluno "0..*" --> "0..1" EnderecoResponsavel : endereco_busca
    Aluno "0..*" --> "0..1" EnderecoResponsavel : endereco_entrega
    Aluno "1" *-- "0..*" PessoaAutorizada : autoriza_retirada
    Aluno "1" *-- "0..*" ComunicadoAusencia : informa_ausencia
    Responsavel "1" o-- "0..*" ComunicadoAusencia : comunica
    Transportador "1" o-- "0..*" ComunicadoAusencia : eh_notificado
    Aluno ..> Turno : cursa
    ComunicadoAusencia ..> PeriodoAusencia : especifica

    Transportador "1" o-- "1..*" Aluno : transporta
    Transportador "1" *-- "0..*" Veiculo : opera
    Transportador "1" *-- "0..*" CalendarioEscolar : mantem
    CalendarioEscolar ..> TipoDiaCalendario : tipo

    Transportador "1" *-- "0..*" ViagemTransporte : realiza
    Veiculo "1" <-- "0..*" ViagemTransporte : usa
    ViagemTransporte "1" *-- "0..*" LocalizacaoGPS : transmite_posicao
    Transportador "1" *-- "0..*" LocalizacaoGPS : emite
    ViagemTransporte "1" *-- "0..*" RegistroEmbarqueDesembarque : registra
    ViagemTransporte "1" *-- "0..*" EventoRota : reporta
    Transportador "1" *-- "0..*" EventoRota : registra_evento
    RegistroEmbarqueDesembarque "0..*" --> "1" Aluno : refere_se_a
    ViagemTransporte ..> StatusViagem : possui
    ViagemTransporte ..> TipoViagem : define
    ViagemTransporte ..> Turno : turno
    RegistroEmbarqueDesembarque ..> TipoRegistro : tipo

    Transportador "1" o-- "0..*" ContratoServico : contratado
    Responsavel "1" o-- "0..*" ContratoServico : contratante
    ContratoServico "0..*" --> "1" Aluno : beneficia
    ContratoServico ..> StatusContrato : estado
    ContratoServico "1" *-- "0..*" Mensalidade : gera_cobrancas
    Responsavel "1" o-- "0..*" Mensalidade : paga
    Transportador "1" o-- "0..*" Mensalidade : recebe
    Mensalidade ..> StatusMensalidade : estado
    Mensalidade "1" *-- "0..*" Pagamento : liquidada_por
    Pagamento ..> MetodoPagamento : metodo

    Responsavel "1" o-- "0..*" Mensagem : conversa
    Transportador "1" o-- "0..*" Mensagem : conversa
    Usuario "1" o-- "0..*" Mensagem : remetente
    Mensagem ..> OrigemMensagem : origem
    Usuario "1" o-- "0..*" Notificacao : recebe_alerta
    Usuario "1" o-- "0..*" PushToken : registra_dispositivo
